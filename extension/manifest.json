{
  "manifest_version": 3,
  "name": "PhishinGAN — AI Phishing Detector",
  "version": "0.1.0",
  "description": "Local, explainable phishing detection for emails and login pages. No API keys, no data leaves the browser.",
  "permissions": ["activeTab", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan this page with PhishinGAN"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
